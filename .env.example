# ==============================================================================
# SmarthAI - Policy Portal: Environment Configuration Blueprint
# Instructions: Copy this file to '.env' and populate with your settings.
# Important: Never commit '.env' to version control.
# ==============================================================================

# Django Secret Key (Generate a cryptographically secure random string for production)
SECRET_KEY=dev-insecure-change-me-for-production-use

# Debug Mode: Set to 'True' for local development, 'False' for production
DEBUG=True

# Allowed Hosts: Comma-separated domain names or IP addresses
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# CSRF Trusted Origins: Comma-separated list of origins permitted to submit forms
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# Database URL: Optional. Leave empty for default SQLite, or supply a PostgreSQL URL
# Example: postgres://username:password@hostname:5432/dbname
DATABASE_URL=

# Sentiment Engine Selection:
# - 'lexicon'     : Fast rule-based engine with English and Hinglish dictionaries (Default)
# - 'transformer' : Multilingual deep learning transformer model (Requires torch & transformers)
SENTIMENT_ENGINE=lexicon

# Analytics Thresholds:
# Minimum responses required before a policy reveals its public sentiment pie chart
MIN_RESPONSES_FOR_CHART=10

# Security & Anti-Abuse:
# Maximum feedback submissions permitted per IP hash per hour
FEEDBACK_RATE_LIMIT_PER_HOUR=5

# Automated Initial Superuser Configuration (Used by build.sh on Cloud deployment)
ADMIN_PASSWORD=admin123
